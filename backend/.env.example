# Copy this file to ".env" and fill in your own values. Never commit ".env".

NODE_ENV=development
PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/taskBoardDB
# MongoDB Atlas (use this one on Render):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskBoardDB?retryWrites=true&w=majority

# Allowed frontend origins (comma separated, no trailing slash)
CLIENT_URLS=http://localhost:3000
# After deploying the frontend add its Vercel URL, e.g.
# CLIENT_URLS=http://localhost:3000,https://your-app.vercel.app
