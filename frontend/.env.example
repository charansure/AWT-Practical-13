# Copy to ".env.local" for local development.
# On Vercel add the same variable in Project Settings -> Environment Variables.
#
# NEXT_PUBLIC_ variables are baked into the JavaScript at BUILD time,
# so after changing it on Vercel you must redeploy.

# Local backend:
NEXT_PUBLIC_API_URL=http://localhost:5000
# Deployed backend (Render):
# NEXT_PUBLIC_API_URL=https://your-api-name.onrender.com
